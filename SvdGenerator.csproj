<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyTitle>SvdGenerator</AssemblyTitle>
    <Product>SvdGenerator</Product>
    <Copyright>Copyright (c) 2019-2026 Thomas Legrand</Copyright>
    <Authors>Thomas Legrand</Authors>
    <Description>Generates typed C++ peripheral headers for ARM Cortex-M targets from a CMSIS-SVD file. The headers are self-contained: strongly-typed, atomic-aware register access with nothing but the standard library.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Version>0.0.0-dev</Version>
    <InformationalVersion>0.0.0-dev</InformationalVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- dotnet tool: `dotnet tool install SvdGenerator` gives the `svdgenerator` command. -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>svdgenerator</ToolCommandName>
    <PackageId>SvdGenerator</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/Otatiaro/SvdGenerator</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Otatiaro/SvdGenerator</RepositoryUrl>
    <PackageTags>cmsis-svd;svd;cortex-m;embedded;cpp;code-generator</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup>
    <!-- The register building blocks every generated header includes: a real C++ file,
         embedded in the generator and written next to the headers. -->
    <EmbeddedResource Include="Support/mmio.hpp" LogicalName="mmio.hpp" />
  </ItemGroup>
  <ItemGroup>
    <!-- The test project lives under tests/ and has its own .csproj. -->
    <Compile Remove="tests/**" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="CMSIS-SVD_Schema_1_1.cs">
      <DependentUpon>CMSIS-SVD_Schema_1_1.xsd</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <None Update="CMSIS-SVD_Schema_1_1.xsd">
      <SubType>Designer</SubType>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Service Include="{508349B6-6B84-4DF5-91F0-309BEEBAD82D}" />
  </ItemGroup>
</Project>
